{
  "description": "HexGraph project hooks imported from the Claude project setup.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/guard-pr-reviewer.sh\"",
            "timeout": 10,
            "statusMessage": "Checking PR-review dispatch"
          }
        ]
      }
    ]
  }
}
